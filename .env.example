# Financial Modeling Prep (FMP) API key — used exclusively for shares-float filtering (250 calls/day free tier)
# Docs: https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=

# Optional Interactive Brokers (TWS / IB Gateway) local socket overrides
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=101
# IBKR_MARKET_DATA_TYPE=1

# SEC EDGAR API User-Agent — required by sec.gov for Historical Mode point-in-time Float lookups
# Format: "AppName contact@yourdomain.com" (rate-limited < 8 req/s)
SEC_EDGAR_USER_AGENT=
